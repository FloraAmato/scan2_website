---
import Layout from '../layouts/Layout.astro';
import CountryList from '../components/CountryList.astro';
import EuropeMap from '../components/EuropeMap.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Home">
  <section class="hero">
    <div class="container">
      <h1>DEUCE Project</h1>
      <p>Improving the enforcement of judicial decisions in cross-border pecuniary claims across the European Union</p>
      <div style="margin-top: 2rem;">
        <a href={`${base}about/`} class="btn">Learn More</a>
        <a href="https://deuce.scan2project.org/home" class="btn btn-accent" style="margin-left: 1rem;" target="_blank" rel="noopener noreferrer">Access Platform</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="text-center">About the Project</h2>
      <p class="text-center text-muted" style="max-width: 800px; margin: 0 auto;">
        The DEUCE Project develops a comprehensive roadmap of enforcement rules in 26 EU Member States,
        alongside a user-friendly IT platform offering practical guidance on European Enforcement Order (EEO)
        and European Order for Payment (EOP) enforcement procedures.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="text-center">Explore Enforcement Procedures</h2>
      <EuropeMap />
      <p class="text-center text-muted" style="max-width: 600px; margin: 1rem auto 2rem;">
        Click on a country for detailed information on EEO and EOP enforcement procedures.
      </p>
      <CountryList />
    </div>
  </section>
</Layout>
