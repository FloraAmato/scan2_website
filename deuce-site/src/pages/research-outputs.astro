---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Research Outputs">
  <div class="page-header">
    <div class="container">
      <h1>Research Outputs</h1>
      <p class="breadcrumb"><a href={base}>Home</a> / Research</p>
    </div>
  </div>

  <section class="content">
    <div class="container">
      <p>
        The DEUCE Project produces comprehensive research on the enforcement of European Enforcement Orders (EEO)
        and European Orders for Payment (EOP) across EU Member States. Below you can find our main research outputs.
      </p>

      <div class="research-item">
        <h2>Roadmap of Enforcement Rules</h2>
        <p>
          A comprehensive roadmap detailing enforcement rules for EEO and EOP in 26 EU Member States,
          providing clarity on cross-border enforcement procedures and identifying best practices.
        </p>
        <p class="coming-soon">Coming soon</p>
      </div>

      <div class="research-item">
        <h2>Comparative Study</h2>
        <p>
          The Comparative and Analytical Study examines enforcement procedures for EEO and EOP judgments
          across all EU Member States, identifying best practices and areas for improvement in cross-border enforcement.
        </p>
        <p class="coming-soon">Coming soon</p>
      </div>

      <div class="research-item">
        <h2>Access the Platform</h2>
        <p>
          For detailed information on enforcement procedures in each Member State, visit our DEUCE Platform.
        </p>
        <p>
          <a href="https://deuce.scan2project.org/home" class="btn btn-accent" target="_blank" rel="noopener noreferrer">Access DEUCE Platform</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .research-item {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .research-item:last-child {
    border-bottom: none;
  }

  .research-item h2 {
    margin-bottom: 1rem;
  }

  .coming-soon {
    display: inline-block;
    background: var(--color-background-alt);
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .video-container {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    margin-top: 1rem;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
  }

  .video-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
</style>
