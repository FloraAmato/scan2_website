# Database Configuration
# Copy this file to .env and update with your own secure values
MYSQL_DATABASE=wp_nlzri
MYSQL_USER=wp_hvl0j
MYSQL_PASSWORD=your_secure_database_password_here
MYSQL_ROOT_PASSWORD=your_secure_root_password_here

# WordPress Site Configuration
WORDPRESS_URL=http://localhost:8080
WORDPRESS_PORT=8080

# WordPress User Password
# After starting containers, run this command to update the password:
# docker-compose run --rm wpcli wp user update bondo2488_zeoxh4x1 --user_pass='YOUR_NEW_PASSWORD'
WP_USER_PASSWORD=your_wordpress_user_password_here
