---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="News & Events">
  <div class="page-header">
    <div class="container">
      <h1>News & Events</h1>
      <p class="breadcrumb"><a href={base}>Home</a> / News & Events</p>
    </div>
  </div>

  <section class="content">
    <div class="container">
      <p>
        Stay updated with the latest news, events, and developments from the DEUCE project.
      </p>

      <div class="news-item">
        <h2>DEUCE Project Launch</h2>
        <p class="event-date">2024</p>

        <p>
          The DEUCE Project has been launched to improve the enforcement of judicial decisions in
          cross-border pecuniary claims across the European Union. Building on the success of the
          SCAN and SCAN II projects, DEUCE focuses specifically on European Enforcement Orders (EEO)
          and European Orders for Payment (EOP).
        </p>

        <p>
          The project brings together a consortium of eleven leading academic institutions, consumer
          associations, and professional organizations from across Europe, coordinated by Vrije
          Universiteit Brussel (VUB).
        </p>
      </div>

      <div class="news-item">
        <h2>Final Conference DEUCE Project</h2>
        <p class="event-date">19ᵗʰ - 20ᵗʰ February 2026</p>
        <div class="event-details">
          <p><strong>Location:</strong> Hoek 38 - Rue de Louvain 38 - 1000 Brussels</p>
        </div>
        <p>
          Join us for the Final Conference of the DEUCE Project, where we will present our research
          findings and discuss the future of cross-border enforcement of EEO and EOP decisions
          across the European Union.
        </p>
        <p>
          <a href={`${base}documents/final_conference_booklet.pdf`} class="btn btn-accent" download>Download Conference Booklet</a>
        </p>
      </div>

      <div class="news-item">
        <h2>DEUCE Platform</h2>
        <p>
          The DEUCE platform provides comprehensive information on EEO and EOP enforcement
          procedures across EU Member States.
        </p>
        <p>
          <a href="https://deuce.scan2project.org/home" class="btn btn-accent" target="_blank" rel="noopener noreferrer">Access DEUCE Platform</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .news-item {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .news-item:last-child {
    border-bottom: none;
  }

  .news-item h2 {
    margin-bottom: 0.5rem;
  }

  .event-date {
    color: var(--color-accent);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .event-details {
    background: var(--color-background-alt);
    padding: 1rem;
    border-radius: 6px;
    margin: 1rem 0;
  }

  .event-details p {
    margin: 0.5rem 0;
  }

  .event-details p:first-child {
    margin-top: 0;
  }

  .event-details p:last-child {
    margin-bottom: 0;
  }

  .video-container {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    margin-top: 1rem;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
  }

  .video-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
</style>
