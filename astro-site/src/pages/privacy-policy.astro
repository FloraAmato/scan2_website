---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Privacy Policy">
  <div class="page-header">
    <div class="container">
      <h1>Privacy Policy</h1>
      <p class="breadcrumb"><a href={base}>Home</a> / Privacy Policy</p>
    </div>
  </div>

  <section class="content">
    <div class="container">
      <h2>Who We Are</h2>
      <p>
        This website is operated by the DEUCE project consortium, coordinated by Vrije Universiteit
        Brussel (VUB), Belgium.
      </p>

      <h2>What Data We Collect</h2>
      <p>
        This is a static informational website. We do not collect personal data through forms or
        user accounts. We may use basic analytics to understand website usage.
      </p>

      <h2>Cookies</h2>
      <p>
        This website may use essential cookies to ensure proper functionality. We do not use
        tracking cookies or third-party advertising cookies.
      </p>

      <h2>Third-Party Links</h2>
      <p>
        This website contains links to external websites, including the DEUCE Platform. These external
        sites have their own privacy policies.
      </p>

      <h2>Contact</h2>
      <p>
        For questions about this privacy policy, please contact the project coordinator at VUB.
      </p>

      <h2>Changes to This Policy</h2>
      <p>
        We may update this privacy policy from time to time. Any changes will be posted on this page.
      </p>

      <p class="text-muted" style="margin-top: 2rem;">
        Last updated: 2024
      </p>
    </div>
  </section>
</Layout>
