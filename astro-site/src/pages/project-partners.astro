---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;

const partners = [
  {
    name: 'Vrije Universiteit Brussel (VUB)',
    country: 'Belgium',
    role: 'Coordinator',
    url: 'https://www.vub.be',
  },
  {
    name: 'Univerza v Ljubljani (UL)',
    country: 'Slovenia',
    role: 'Partner',
    url: 'https://www.uni-lj.si',
  },
  {
    name: 'Vilniaus Universitetas (VU)',
    country: 'Lithuania',
    role: 'Partner',
    url: 'https://www.vu.lt',
  },
  {
    name: 'Sveučilište u Zagrebu - Pravni Fakultet (UniZG)',
    country: 'Croatia',
    role: 'Partner',
    url: 'https://www.pravo.unizg.hr',
  },
  {
    name: 'Università degli Studi di Napoli Federico II (UNINA)',
    country: 'Italy',
    role: 'Partner',
    url: 'https://www.unina.it',
  },
  {
    name: 'Universitat de Barcelona (UB)',
    country: 'Spain',
    role: 'Partner',
    url: 'https://www.ub.edu',
  },
  {
    name: 'Tallinna Tehnikaülikool (TalTech)',
    country: 'Estonia',
    role: 'Partner',
    url: 'https://taltech.ee',
  },
  {
    name: 'Adiconsum Associazione Difesa Consumatori APS',
    country: 'Italy',
    role: 'Partner',
    url: 'https://www.adiconsum.it',
  },
  {
    name: 'Fondation de la Chambre Européenne des Huissiers de Justice (EUBF)',
    country: 'Belgium',
    role: 'Partner',
    url: 'https://www.uihj.com',
  },
  {
    name: "Fédération des Barreaux d'Europe (FBE)",
    country: 'France',
    role: 'Partner',
    url: 'https://www.fbe.org',
  },
  {
    name: 'Zentrum für Europäischen Verbraucherschutz e.V. (ZEV)',
    country: 'Germany',
    role: 'Partner',
    url: 'https://www.evz.de',
  }
];
---

<Layout title="Project Partners">
  <div class="page-header">
    <div class="container">
      <h1>Project Partners</h1>
      <p class="breadcrumb"><a href={base}>Home</a> / Partners</p>
    </div>
  </div>

  <section class="content">
    <div class="container">
      <p>
        The DEUCE project brings together a consortium of leading European universities, research
        institutions, consumer associations, and professional organizations with expertise in EU civil
        procedure, enforcement law, consumer protection, and information technology.
      </p>

      <div class="card-grid" style="margin-top: 2rem;">
        {partners.map(partner => (
          <a href={partner.url} class="card partner-card" target="_blank" rel="noopener noreferrer">
            <h3>{partner.name}</h3>
            <p><strong>{partner.country}</strong> {partner.role === 'Coordinator' ? '– Coordinator' : ''}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .partner-card {
    text-decoration: none;
    color: inherit;
  }

  .partner-card h3 {
    color: var(--color-primary);
    transition: color 0.2s;
  }

  .partner-card:hover h3 {
    color: var(--color-accent);
  }
</style>
