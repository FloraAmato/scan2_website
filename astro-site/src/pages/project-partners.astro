---
import Layout from '../layouts/Layout.astro';

const partners = [
  {
    name: 'Vrije Universiteit Brussel (VUB)',
    country: 'Belgium',
    role: 'Coordinator',
  },
  {
    name: 'Univerza v Ljubljani (UL)',
    country: 'Slovenia',
    role: 'Partner',
  },
  {
    name: 'Sveučilište u Zagrebu – Pravni Fakultet (UniZg)',
    country: 'Croatia',
    role: 'Partner',
  },
  {
    name: 'Vilniaus Universitetas (VU)',
    country: 'Lithuania',
    role: 'Partner',
  },
  {
    name: 'Adiconsum Associazione Difesa Consumatori APS (ADICONSUM)',
    country: 'Italy',
    role: 'Partner',
  },
  {
    name: 'Fondation de la Chambre Européenne des Huissiers de Justice (EUBF)',
    country: 'Belgium',
    role: 'Partner',
  },
  {
    name: 'Fondazione Bruno Kessler (FBK)',
    country: 'Italy',
    role: 'Partner',
  },
  {
    name: 'Tallinna Tehnikaülikool (TalTech)',
    country: 'Estonia',
    role: 'Partner',
  },
  {
    name: 'Zentrum für Europäischen Verbraucherschutz e.V. (ZEV)',
    country: 'Germany',
    role: 'Partner',
  },
  {
    name: 'Fédération des Barreaux d\'Europe (FBE)',
    country: 'France',
    role: 'Partner',
  }
];
---

<Layout title="Project Partners">
  <div class="page-header">
    <div class="container">
      <h1>Project Partners</h1>
      <p class="breadcrumb"><a href="/">Home</a> / Partners</p>
    </div>
  </div>

  <section class="content">
    <div class="container">
      <p>
        The SCAN II project brings together a consortium of leading European universities, research
        institutions, and professional organizations with expertise in EU civil procedure, enforcement
        law, consumer protection, and information technology.
      </p>

      <div class="card-grid" style="margin-top: 2rem;">
        {partners.map(partner => (
          <div class="card">
            <h3>{partner.name}</h3>
            <p><strong>{partner.country}</strong> {partner.role === 'Coordinator' ? '– Coordinator' : ''}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
