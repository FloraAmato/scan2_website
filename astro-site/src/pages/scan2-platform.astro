---
import Layout from '../layouts/Layout.astro';
import CountryList from '../components/CountryList.astro';
---

<Layout title="SCAN2 Platform">
  <div class="page-header">
    <div class="container">
      <h1>SCAN2 Platform</h1>
      <p class="breadcrumb"><a href="/">Home</a> / Platform</p>
    </div>
  </div>

  <section class="content">
    <div class="container">
      <p>
        The SCAN2 Platform provides comprehensive information on national enforcement procedures for
        EU civil judgments across all Member States.
      </p>

      <div class="card" style="background: var(--color-background-alt); margin: 2rem 0; text-align: center;">
        <h2>Access the Platform</h2>
        <p>Visit the SCAN2 e-platform for detailed information on enforcement procedures.</p>
        <a href="https://portal.scan2.vub.be" class="btn" target="_blank" rel="noopener noreferrer">
          Go to SCAN2 Portal &rarr;
        </a>
      </div>

      <h2>What You'll Find</h2>
      <ul>
        <li><strong>National Enforcement Procedures:</strong> Step-by-step guides for each Member State</li>
        <li><strong>Competent Authorities:</strong> Contact information for courts and enforcement bodies</li>
        <li><strong>Forms and Documents:</strong> Required forms and documentation</li>
        <li><strong>Costs and Fees:</strong> Information on enforcement costs</li>
        <li><strong>Timelines:</strong> Expected duration of enforcement procedures</li>
      </ul>

      <h2>Video Tutorials</h2>
      <p>
        Watch our video tutorials explaining how to use the SCAN2 platform and understand enforcement procedures.
      </p>

      <h2>Select a Country</h2>
      <p>
        Browse enforcement information by Member State:
      </p>
      <CountryList />
    </div>
  </section>
</Layout>
