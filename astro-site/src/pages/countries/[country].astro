---
import Layout from '../../layouts/Layout.astro';

// Country data - easy to customize for your project
const countries = {
  'austria': { name: 'Austria', flag: '🇦🇹', capital: 'Vienna' },
  'belgium': { name: 'Belgium', flag: '🇧🇪', capital: 'Brussels' },
  'bulgaria': { name: 'Bulgaria', flag: '🇧🇬', capital: 'Sofia' },
  'croatia': { name: 'Croatia', flag: '🇭🇷', capital: 'Zagreb' },
  'cyprus': { name: 'Cyprus', flag: '🇨🇾', capital: 'Nicosia' },
  'czechia': { name: 'Czechia', flag: '🇨🇿', capital: 'Prague' },
  'denmark': { name: 'Denmark', flag: '🇩🇰', capital: 'Copenhagen' },
  'estonia': { name: 'Estonia', flag: '🇪🇪', capital: 'Tallinn' },
  'finland': { name: 'Finland', flag: '🇫🇮', capital: 'Helsinki' },
  'france': { name: 'France', flag: '🇫🇷', capital: 'Paris' },
  'germany': { name: 'Germany', flag: '🇩🇪', capital: 'Berlin' },
  'greece': { name: 'Greece', flag: '🇬🇷', capital: 'Athens' },
  'hungary': { name: 'Hungary', flag: '🇭🇺', capital: 'Budapest' },
  'ireland': { name: 'Ireland', flag: '🇮🇪', capital: 'Dublin' },
  'italy': { name: 'Italy', flag: '🇮🇹', capital: 'Rome' },
  'latvia': { name: 'Latvia', flag: '🇱🇻', capital: 'Riga' },
  'lithuania': { name: 'Lithuania', flag: '🇱🇹', capital: 'Vilnius' },
  'luxembourg': { name: 'Luxembourg', flag: '🇱🇺', capital: 'Luxembourg City' },
  'malta': { name: 'Malta', flag: '🇲🇹', capital: 'Valletta' },
  'netherlands': { name: 'Netherlands', flag: '🇳🇱', capital: 'Amsterdam' },
  'poland': { name: 'Poland', flag: '🇵🇱', capital: 'Warsaw' },
  'portugal': { name: 'Portugal', flag: '🇵🇹', capital: 'Lisbon' },
  'romania': { name: 'Romania', flag: '🇷🇴', capital: 'Bucharest' },
  'slovakia': { name: 'Slovakia', flag: '🇸🇰', capital: 'Bratislava' },
  'slovenia': { name: 'Slovenia', flag: '🇸🇮', capital: 'Ljubljana' },
  'spain': { name: 'Spain', flag: '🇪🇸', capital: 'Madrid' },
  'sweden': { name: 'Sweden', flag: '🇸🇪', capital: 'Stockholm' },
};

export function getStaticPaths() {
  return Object.keys(countries).map(country => ({
    params: { country }
  }));
}

const { country } = Astro.params;
const countryData = countries[country as keyof typeof countries];

if (!countryData) {
  return Astro.redirect('/404');
}
---

<Layout title={countryData.name}>
  <div class="page-header">
    <div class="container">
      <h1><span style="font-size: 1.2em; margin-right: 0.5rem;">{countryData.flag}</span> {countryData.name}</h1>
      <p class="breadcrumb">
        <a href="/">Home</a> / <a href="/network">Network</a> / {countryData.name}
      </p>
    </div>
  </div>

  <section class="content">
    <div class="container">
      <h2>Status of Digitalisation of ESCP Enforcement Procedures</h2>
      <p>
        Information about the digitalisation status of European Small Claims Procedure (ESCP)
        enforcement in {countryData.name}.
      </p>

      <div class="info-table">
        <table>
          <tr>
            <th>Country</th>
            <td>{countryData.name}</td>
          </tr>
          <tr>
            <th>Capital</th>
            <td>{countryData.capital}</td>
          </tr>
          <tr>
            <th>EU Member</th>
            <td>Yes</td>
          </tr>
        </table>
      </div>

      <h2>Status of Digitalisation of EOP Enforcement Procedures</h2>
      <p>
        Information about the digitalisation status of European Order for Payment (EOP)
        enforcement in {countryData.name}.
      </p>

      <h2>General Information</h2>
      <p>
        For detailed information about enforcement procedures in {countryData.name}, including
        competent authorities, costs, and timelines, please visit the SCAN2 Platform.
      </p>

      <div class="card" style="background: var(--color-background-alt); margin: 2rem 0; text-align: center;">
        <h3>Access Detailed Information</h3>
        <p>View the complete enforcement guide for {countryData.name} on the SCAN2 Platform.</p>
        <a href="https://portal.scan2.vub.be" class="btn" target="_blank" rel="noopener noreferrer">
          Go to SCAN2 Portal &rarr;
        </a>
      </div>

      <h2>Competent Authorities</h2>
      <ul>
        <li>Courts responsible for enforcement</li>
        <li>Bailiffs / Enforcement officers</li>
        <li>Relevant ministries and agencies</li>
      </ul>

      <h2>Key Information</h2>
      <ul>
        <li><strong>Language:</strong> Official language(s) of {countryData.name}</li>
        <li><strong>Currency:</strong> Euro (EUR) / National currency</li>
        <li><strong>Legal System:</strong> Civil law tradition</li>
      </ul>

      <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--color-border);">
        <p>
          <a href="/network">&larr; Back to Network</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .info-table {
    margin: 1.5rem 0;
  }

  .info-table table {
    max-width: 500px;
  }

  .info-table th {
    width: 150px;
  }
</style>
