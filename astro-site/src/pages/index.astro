---
import Layout from '../layouts/Layout.astro';
import CountryList from '../components/CountryList.astro';
import EuropeMap from '../components/EuropeMap.astro';
---

<Layout title="Home">
  <section class="hero">
    <div class="container">
      <h1>SCAN II Project</h1>
      <p>Supporting the digitalization of cross-border enforcement of civil claims in Europe</p>
      <div style="margin-top: 2rem;">
        <a href="/about" class="btn">Learn More</a>
        <a href="https://portal.scan2.vub.be" class="btn btn-accent" style="margin-left: 1rem;" target="_blank" rel="noopener noreferrer">Access Platform</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="text-center">About the Project</h2>
      <p class="text-center text-muted" style="max-width: 800px; margin: 0 auto;">
        The SCAN II Project is developed upon the results of the SCAN project and aims at contributing to
        the correct and coherent implementation of EU civil procedures in cross-border cases,
        enhancing access to justice through the further development of the SCAN e-platform and database.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="text-center">Explore Enforcement Procedures</h2>
      <EuropeMap />
      <p class="text-center text-muted" style="max-width: 600px; margin: 1rem auto 2rem;">
        Click on a country for detailed information on enforcement procedures.
      </p>
      <CountryList />
    </div>
  </section>
</Layout>
