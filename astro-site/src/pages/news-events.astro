---
import Layout from '../layouts/Layout.astro';
---

<Layout title="News & Events">
  <div class="page-header">
    <div class="container">
      <h1>News & Events</h1>
      <p class="breadcrumb"><a href="/">Home</a> / News & Events</p>
    </div>
  </div>

  <section class="content">
    <div class="container">
      <p>
        Stay updated with the latest news, events, and developments from the SCAN II project.
      </p>

      <h2>Upcoming Events</h2>
      <div class="card" style="margin: 1rem 0;">
        <h3>SCAN II Final Conference</h3>
        <p class="text-muted">Date to be announced</p>
        <p>
          The final conference will present the results of the SCAN II project and discuss the future
          of cross-border enforcement in the EU.
        </p>
      </div>

      <h2>Past Events</h2>
      <div class="card" style="margin: 1rem 0;">
        <h3>Project Kick-off Meeting</h3>
        <p class="text-muted">Brussels, Belgium</p>
        <p>
          The SCAN II project consortium held its kick-off meeting to launch the project activities.
        </p>
      </div>

      <h2>News</h2>
      <div class="card" style="margin: 1rem 0;">
        <h3>SCAN2 Platform Launch</h3>
        <p>
          The SCAN2 e-platform is now available, providing comprehensive information on enforcement
          procedures across EU Member States.
        </p>
        <a href="/scan2-platform">Learn more &rarr;</a>
      </div>

      <h2>Subscribe to Updates</h2>
      <p>
        For the latest news and updates, follow us on our social media channels or contact us directly.
      </p>
    </div>
  </section>
</Layout>
