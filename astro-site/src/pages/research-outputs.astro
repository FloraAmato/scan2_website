---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Research Outputs">
  <div class="page-header">
    <div class="container">
      <h1>Research Outputs</h1>
      <p class="breadcrumb"><a href={base}>Home</a> / Research</p>
    </div>
  </div>

  <section class="content">
    <div class="container">
      <p>
        The DEUCE project produces comprehensive research on the enforcement of European Enforcement Orders (EEO)
        and European Orders for Payment (EOP) across EU Member States. Below you can find our main research outputs.
      </p>

      <div class="research-item">
        <h2>EEO/EOP Roadmap</h2>
        <p>
          The DEUCE Roadmap provides comprehensive guidance on enforcement procedures for EEO and EOP
          decisions across all EU Member States, helping legal professionals and citizens navigate
          cross-border enforcement.
        </p>
        <p class="coming-soon">Coming soon</p>
      </div>

      <div class="research-item">
        <h2>Comparative Study</h2>
        <p>
          Our comparative study examines enforcement procedures for EEO and EOP decisions across
          EU Member States, identifying best practices and areas for improvement in cross-border enforcement.
        </p>
        <p class="coming-soon">Coming soon</p>
      </div>

      <div class="research-item">
        <h2>Access the Platform</h2>
        <p>
          For detailed information on EEO/EOP enforcement procedures in each Member State, visit our DEUCE Platform.
        </p>
        <p>
          <a href="https://deuce.scan2project.org/home" class="btn btn-accent" target="_blank" rel="noopener noreferrer">Access DEUCE Platform</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .research-item {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .research-item:last-child {
    border-bottom: none;
  }

  .research-item h2 {
    margin-bottom: 1rem;
  }

  .video-container {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    margin-top: 1rem;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
  }

  .video-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
</style>
